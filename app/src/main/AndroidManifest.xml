<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Occasional per-net location accents: region-level question flavoring. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Signature permission declared by the Tail habit tracker (same keystore);
         needed to query its habits ContentProvider and target its receivers. -->
    <uses-permission android:name="com.example.tail.permission.TAIL_INTEGRATION" />

    <!-- Android 11+ package visibility: allow querying the Tail app -->
    <queries>
        <package android:name="com.example.tail" />
        <provider android:authorities="com.example.tail.provider" />
        <!-- Podcast recommendations: discover installed podcast apps and the
             handlers for episode links (Apple Podcasts directory pages). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="itms-podcasts" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="antennapod-subscribe" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="pktc" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="podcastaddict" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="podcasts.apple.com" />
        </intent>
    </queries>

    <application
        android:name=".InuitApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inuit">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Inuit"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps batch generation alive when the app is closed or the screen
             is off; START_STICKY restarts it (and the batch) after process death. -->
        <service
            android:name=".BatchGenService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>

</manifest>
